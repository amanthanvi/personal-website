---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  image?: string;
}

const { title, description, pubDate, updatedDate, image } = Astro.props;

const rawContent = await Astro.slots.render('default');
const wordCount = rawContent.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={`${title} — Aman Thanvi`} description={description} image={image} back={true}>
  <article>
    <header class="mb-8">
      <h1 class="text-[1.75rem] leading-[1.15] tracking-[-0.021em]">{title}</h1>
      <p class="mt-2 flex flex-wrap items-baseline gap-x-2 text-[0.8125rem] text-faint">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
