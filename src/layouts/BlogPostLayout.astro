---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
}

const { title, description, pubDate, updatedDate } = Astro.props;

const rawContent = await Astro.slots.render('default');
const wordCount = rawContent.replace(/<[^>]*>/g, '').split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={`${title} — Aman Thanvi`} description={description} back={true}>
  <article>
    <header class="mb-8">
      <h1 class="text-[1.75rem] leading-[1.15] tracking-[-0.021em]">{title}</h1>
      <p class="mt-2 flex flex-wrap items-baseline gap-x-2 text-[0.8125rem] text-faint">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )
        }
        <span aria-hidden="true">·</span>
        <span>{readingTime} min read</span>
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* Prose runs one step larger than the index, at the same measure. */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.72;
  }

  .prose > * + * {
    margin-top: 1.25rem;
  }

  .prose h2 {
    margin-top: 2.5rem;
    font-size: 1.1875rem;
  }

  .prose h3 {
    margin-top: 2rem;
    font-size: 1rem;
  }

  .prose a {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    padding-bottom: 1px;
    transition: background-size 0.16s var(--ease-out);
  }

  .prose a:hover {
    background-size: 100% 2px;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }

  .prose ul {
    list-style: disc;
  }

  .prose ol {
    list-style: decimal;
  }

  .prose li + li {
    margin-top: 0.375rem;
  }

  .prose li::marker {
    color: var(--color-faint);
  }

  .prose code {
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .prose pre {
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 0.875rem 1rem;
    overflow-x: auto;
    font-size: 0.875rem;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: 1px solid var(--color-border);
    padding-left: 1rem;
    color: var(--color-muted);
  }

  .prose hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .prose img {
    border-radius: var(--radius);
    max-width: 100%;
    height: auto;
  }

  .prose strong {
    font-weight: 600;
  }
</style>
