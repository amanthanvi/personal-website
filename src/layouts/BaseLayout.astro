---
import BaseHead from '../components/layout/BaseHead.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Post pages carry a back-link beside the theme control. */
  back?: boolean;
  /** 404 centres its column instead of top-aligning it. */
  centered?: boolean;
}

const { title, description, image, noindex, back = false, centered = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body class="min-h-screen">
    <SkipLink />
    <div
      class:list={['column mx-auto flex w-full flex-col px-6', centered && 'min-h-screen']}
    >
      <Header back={back} />
      <main id="content" class:list={['flex-1', centered && 'flex items-center']}>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .column {
    max-width: calc(var(--measure) + 3rem);
  }
</style>
