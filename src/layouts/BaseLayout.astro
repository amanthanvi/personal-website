---
import BaseHead, { type Article } from '../components/layout/BaseHead.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  /** Present on post pages: switches the head to article metadata. */
  article?: Article;
  /** The homepage describes the person; other pages do not repeat it. */
  person?: boolean;
  /** Post pages carry a back-link beside the theme control. */
  back?: boolean;
  /** 404 centres its column instead of top-aligning it. */
  centered?: boolean;
}

const {
  title,
  description,
  image,
  noindex,
  article,
  person = false,
  back = false,
  centered = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      article={article}
      person={person}
    />
  </head>
  <body class="min-h-screen">
    <SkipLink />
    <!-- full viewport height on every page, so a short page's footer sits at the bottom -->
    <div class="column mx-auto flex min-h-dvh w-full flex-col px-6">
      <Header back={back} />
      <main id="content" class:list={['flex-1', centered && 'flex items-center']}>
        <slot />
      </main>
      <Footer flush={centered} />
    </div>
  </body>
</html>

<style>
  .column {
    max-width: calc(var(--measure) + 3rem);
  }
</style>
