---
import ThemeToggle from '../ui/ThemeToggle.astro';

interface Props {
  /** Post pages get a way back; the homepage does not need one. */
  back?: boolean;
}

const { back = false } = Astro.props;
---

<header class="flex items-center justify-between gap-4 py-6">
  {
    back ? (
      <a href="/" class="link text-sm">
        <span aria-hidden="true">←</span> Aman Thanvi
      </a>
    ) : (
      <span />
    )
  }
  <ThemeToggle />
</header>
