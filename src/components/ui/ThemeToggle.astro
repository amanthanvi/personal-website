<button
  data-theme-toggle
  type="button"
  aria-label="Switch to dark mode"
  class="theme-toggle inline-flex h-8 w-8 items-center justify-center border border-border text-muted"
>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
    </svg>
    <svg data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.1 5.1l1.4 1.4M17.5 17.5l1.4 1.4M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4" />
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    border-radius: var(--radius);
    transition:
      color 0.16s var(--ease-out),
      border-color 0.16s var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-faint);
  }

  .theme-toggle__icon {
    display: grid;
    place-items: center;
  }

  .theme-toggle__icon svg {
    grid-area: 1 / 1;
    width: 0.875rem;
    height: 0.875rem;
    transition:
      opacity 0.16s var(--ease-out),
      transform 0.16s var(--ease-out);
  }

  .theme-toggle__icon [data-icon="moon"] {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .theme-toggle__icon [data-icon="sun"] {
    opacity: 0;
    transform: rotate(-40deg) scale(0.65);
  }

  :global([data-resolved="dark"]) .theme-toggle__icon [data-icon="moon"] {
    opacity: 0;
    transform: rotate(40deg) scale(0.65);
  }

  :global([data-resolved="dark"]) .theme-toggle__icon [data-icon="sun"] {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle__icon svg {
      transition: none;
    }
  }
</style>

<script>
  import { initThemeToggle, toggleTheme, resolveTheme } from '../../scripts/theme';

  function syncButton(btn: HTMLButtonElement): void {
    const dark = resolveTheme() === 'dark';
    btn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    btn.setAttribute('aria-pressed', String(dark));
  }

  function syncAll(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(syncButton);
  }

  initThemeToggle();

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      toggleTheme();
      syncAll();
    });
  });

  // The system-preference listener in initThemeToggle can change the resolved
  // theme without a click, so keep the label honest.
  new MutationObserver(syncAll).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme', 'data-resolved'],
  });

  syncAll();
</script>
