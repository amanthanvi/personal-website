---
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';
import { contactLinks } from '../../lib/site';
---

<section id="hero" aria-labelledby="hero-heading">
  <Image
    src={portrait}
    alt="Aman Thanvi, smiling."
    width={80}
    height={80}
    densities={[1, 2]}
    format="webp"
    quality={80}
    loading="eager"
    fetchpriority="high"
    class="mb-6 block aspect-square w-20 rounded-[var(--radius)] object-cover"
  />

  <!-- the homepage name runs a step above post titles so the front page reads as the front page -->
  <h1 id="hero-heading" class="text-masthead">Aman Thanvi</h1>

  <p class="mt-2 text-lede">
    Computer science and cybersecurity. Building things. Overthinking. If not that,
    probably sleeping.
  </p>

  <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
    {contactLinks.map(({ label, href }) => <a class="link hit" href={href}>{label}</a>)}
  </p>
</section>
