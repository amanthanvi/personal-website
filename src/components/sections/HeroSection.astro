---
const links = [
  { label: 'Email', href: 'mailto:contact@amanthanvi.com' },
  { label: 'GitHub', href: 'https://github.com/amanthanvi' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/amanthanvi' },
];
---

<section id="hero" aria-labelledby="hero-heading">
  <img
    src="/images/profile.jpg"
    alt="Aman Thanvi, smiling."
    width="160"
    height="160"
    class="portrait mb-6 block aspect-square w-20 object-cover"
    decoding="async"
    loading="eager"
  />

  <h1 id="hero-heading" class="text-[1.75rem] leading-[1.15] tracking-[-0.021em]">
    Aman Thanvi
  </h1>

  <p class="mt-2 text-[1.0625rem] leading-[1.6]">
    Computer science and cybersecurity. Building things. Overthinking. If not that,
    probably sleeping.
  </p>

  <p class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
    {
      links.map(({ label, href }) => (
        <a
          class="link"
          href={href}
          {...href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
        >
          {label}
          {href.startsWith('http') && <span class="sr-only"> (opens in a new tab)</span>}
        </a>
      ))
    }
  </p>
</section>

<style>
  .portrait {
    border-radius: var(--radius);
  }
</style>
