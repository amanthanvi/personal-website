---
import { z } from 'astro/zod';
import SectionHeading from '../ui/SectionHeading.astro';
import publications from '../../content/publications.json';

/**
 * `projects` and `blog` are schema-validated content collections; this JSON
 * was the one content source cast with `as`, so a malformed edit rendered
 * `undefined` instead of failing. Parse it so the build breaks loudly.
 */
const publicationSchema = z.object({
  title: z.string(),
  venue: z.string(),
  period: z.string(),
  description: z.string(),
  tags: z.array(z.string()),
  /** A public paper, DOI, or write-up. Only real, public destinations. */
  url: z.url({ protocol: /^https?$/ }).optional(),
});

const entries = z.array(publicationSchema).parse(publications);
---

<section id="research" class="mt-14" aria-labelledby="research-heading">
  <SectionHeading id="research-heading" label="Research" />

  {
    entries.map((pub) => (
      <article class="row border-t border-border py-4 last:border-b">
        {pub.url ? (
          <a class="row-link" href={pub.url}>
            <h3 class="row-title inline text-title">{pub.title}</h3>
          </a>
        ) : (
          <h3 class="text-title">{pub.title}</h3>
        )}
        {/* venue and period share one short line, so a long title cannot split them */}
        <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 text-label text-faint">
          <span>{pub.venue}</span>
          <span class="tnum shrink-0">{pub.period}</span>
        </div>
        <p class="mt-1.5 text-row text-muted">{pub.description}</p>
        <p class="mt-2 text-label text-faint">{pub.tags.join(' · ')}</p>
      </article>
    ))
  }
</section>
