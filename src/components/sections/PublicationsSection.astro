---
import SectionHeading from '../ui/SectionHeading.astro';
import publications from '../../content/publications.json';

interface PublicationEntry {
  title: string;
  venue: string;
  period: string;
  description: string;
  tags: string[];
}

const entries = publications as PublicationEntry[];
---

<section id="research" class="mt-14" aria-labelledby="research-heading">
  <SectionHeading id="research-heading" label="Research" />

  {
    entries.map((pub) => (
      <article class="border-t border-border py-4 last:border-b">
        <h3 class="text-[0.9375rem]">{pub.title}</h3>
        {/* venue and period share one short line, so a long title cannot split them */}
        <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 text-[0.8125rem] text-faint">
          <span>{pub.venue}</span>
          <span class="tnum shrink-0">{pub.period}</span>
        </div>
        <p class="mt-1.5 text-muted">{pub.description}</p>
      </article>
    ))
  }
</section>
