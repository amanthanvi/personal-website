---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import { postPath, formatDate } from '../../lib/posts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<section id="writing" class="mt-14" aria-labelledby="writing-heading">
  <SectionHeading id="writing-heading" label="Writing" />

  {
    posts.length > 0 ? (
      posts.map((post) => (
        <article class="border-t border-border py-4 last:border-b">
          <a class="row-link block" href={postPath(post)}>
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
              <h3 class="row-title text-[0.9375rem]">{post.data.title}</h3>
              <time
                class="shrink-0 text-[0.8125rem] text-faint"
                datetime={post.data.pubDate.toISOString()}
              >
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            <p class="mt-1 text-muted">{post.data.description}</p>
          </a>
        </article>
      ))
    ) : (
      <p class="border-t border-border py-4 text-muted">Nothing published yet.</p>
    )
  }
</section>
