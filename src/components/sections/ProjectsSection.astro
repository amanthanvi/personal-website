---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="mt-14" aria-labelledby="projects-heading">
  <SectionHeading id="projects-heading" label="Projects" />

  {
    projects.map((project) => {
      // The title links to the live site when there is one, else to the source.
      const primary = project.data.url ?? project.data.github;
      const showSource = Boolean(project.data.github && project.data.url);

      return (
        <article class="border-t border-border py-4 last:border-b">
          {primary ? (
            <a
              class="row-link inline-flex items-baseline gap-1.5"
              href={primary}
              target="_blank"
              rel="noopener noreferrer"
            >
              <h3 class="row-title text-[0.9375rem]">{project.data.title}</h3>
              <span class="text-[0.8125rem] text-faint" aria-hidden="true">↗</span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          ) : (
            <h3 class="text-[0.9375rem]">{project.data.title}</h3>
          )}

          <p class="mt-1 text-muted">{project.data.description}</p>

          <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="text-[0.8125rem] text-faint">{project.data.tags.join(' · ')}</p>
            {showSource && (
              <a
                class="link text-[0.8125rem]"
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                Source<span class="sr-only"> for {project.data.title} (opens in a new tab)</span>
              </a>
            )}
          </div>
        </article>
      );
    })
  }
</section>
