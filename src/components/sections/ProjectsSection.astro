---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="mt-14" aria-labelledby="projects-heading">
  <SectionHeading id="projects-heading" label="Projects" />

  {
    projects.map((project) => {
      // The title links to the live site when there is one, else to the source.
      const primary = project.data.url ?? project.data.github;
      const showSource = Boolean(project.data.github && project.data.url);

      return (
        <article class="row border-t border-border py-4 last:border-b">
          {primary ? (
            <a class="row-link" href={primary}>
              <h3 class="row-title inline text-title">{project.data.title}</h3>
            </a>
          ) : (
            <h3 class="text-title">{project.data.title}</h3>
          )}

          <p class="mt-1 text-row text-muted">{project.data.description}</p>

          <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <p class="text-label text-faint">{project.data.tags.join(' · ')}</p>
            {showSource && (
              <a class="link hit row-extra text-label" href={project.data.github}>
                Source<span class="sr-only"> for {project.data.title}</span>
              </a>
            )}
          </div>
        </article>
      );
    })
  }
</section>
